# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
#
# Файл .env в git не попадает (см. .gitignore).

# Ключ DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key

# Токен бота от @BotFather
TELEGRAM_TOKEN=123456789:AA-your-token

# ID чата или канала (число; у каналов начинается с -100)
TELEGRAM_CHAT_ID=-1001234567890

# Опционально: сухой прогон — собрать и разложить, но не отправлять.
# DRY_RUN=1
